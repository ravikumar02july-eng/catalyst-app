# Catalyst Breeze read-only data service
# Set these in your shell or a private server .env file. Never commit real values.
BREEZE_API_KEY=your_breeze_api_key
BREEZE_API_SECRET=your_breeze_api_secret
BREEZE_SESSION_TOKEN=your_breeze_session_token
# For local development only. In deployment, set this to your app origin(s).
CORS_ORIGINS=*
